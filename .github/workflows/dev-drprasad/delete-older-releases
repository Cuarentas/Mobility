name: 'Delete Old Releases'
on:
  schedule:
    - cron: '0 0 * * *' # 每天午夜运行
  workflow_dispatch:

jobs:
  delete:
    runs-on: ubuntu-latest
    steps:
      - uses: dev-drprasad/delete-older-releases@v0.3.4
        with:
          keep_latest: 3 # 保留最近3个版本，其余删除
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
